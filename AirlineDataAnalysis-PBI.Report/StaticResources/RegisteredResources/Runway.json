{
  "name": "Runway",
  "dataColors": [
    "#1673C8",
    "#5BC0EB",
    "#0A2540",
    "#F5A623",
    "#5B6B7F",
    "#2BAE66",
    "#E4572E",
    "#8E9AAF"
  ],
  "foreground": "#0B1B2E",
  "foregroundNeutralSecondary": "#5B6B7F",
  "background": "#FFFFFF",
  "backgroundLight": "#EEF3F8",
  "tableAccent": "#1673C8",
  "good": "#2BAE66",
  "neutral": "#5BC0EB",
  "bad": "#F5A623",
  "textClasses": {
    "title": {
      "fontFace": "'Bahnschrift SemiBold', 'Bahnschrift', 'Segoe UI Semibold', sans-serif",
      "fontSize": 11,
      "color": "#0B1B2E"
    },
    "label": {
      "fontFace": "'Segoe UI', sans-serif",
      "fontSize": 10,
      "color": "#5B6B7F"
    },
    "callout": {
      "fontFace": "'Bahnschrift SemiBold', 'Bahnschrift', 'Segoe UI Semibold', sans-serif",
      "fontSize": 24,
      "color": "#0A2540"
    },
    "header": {
      "fontFace": "'Bahnschrift SemiBold', 'Bahnschrift', 'Segoe UI Semibold', sans-serif",
      "fontSize": 11,
      "color": "#0B1B2E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9E2EC"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B1B2E"
              }
            },
            "fontSize": 11,
            "fontFamily": "'Bahnschrift SemiBold', 'Bahnschrift', 'Segoe UI Semibold', sans-serif"
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF3F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#0A2540"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontSize": 10,
            "backColorSecondary": {
              "solid": {
                "color": "#F2F7FC"
              }
            }
          }
        ],
        "subTotals": [
          {
            "rowSubtotals": true
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#0A2540"
              }
            }
          }
        ]
      }
    }
  }
}