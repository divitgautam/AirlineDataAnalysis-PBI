              {
                "textRuns": [
                  {
                    "value": "Why RASK",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#0B1B2E",
                      "fontFamily": "'Bahnschrift SemiBold', 'Bahnschrift', 'Segoe UI Semibold', sans-serif"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It is the airline industry's standard measure of how well capacity turns into revenue: every seat flown, every km.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Formula: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "RASK = seat-km load factor x yield per RPK, so it rises by filling seats or by earning more per passenger-km.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2025 YTD: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "₹0.176 per seat-km, +15% vs last year (on target).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Watch: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "short routes earn more per km. Compare routes of similar length, not the whole network.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Edit the measure [RASK Target Growth %] to change the target.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              }
