  "visual": {
    "visualType": "textbox",
    "drillFilterOtherVisuals": true,
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Business findings",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#0B1B2E",
                      "fontFamily": "'Bahnschrift SemiBold', 'Bahnschrift', 'Segoe UI Semibold', sans-serif"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Growth is price-led. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "Jan to May 2025 vs 2024: passengers +25%, revenue +71%. Fares rose 39% from Nov 2024 and load factor still went up.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Pune is the network. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "31% of revenue departs PNQ; 86% of flights touch PNQ, BOM or BLR. 45 of 179 routes make 80% of revenue.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. 53 star routes carry 40% of revenue. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "48 routes sit below the network on both load factor and RASK (19% of revenue), led by BLR-BOM and DEL-GOX.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. RASK is on target. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "₹0.176 per seat-km in 2025, +15% vs last year; yield explains almost 90% of the gain.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "5. International underperforms. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "4% of flights, 7% of revenue, but load factor 49% vs 59% domestic.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "6. Summer is the soft spot. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "Jul to Oct 2024 ran at 55.9% load factor and the lowest RASK; there is no weekday pattern.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "7. 2025 outlook: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "about ₹63.9 Cr revenue if fares hold, ₹60.2 Cr if they settle, vs ₹40.1 Cr in 2024.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "8. Biggest lever: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#1673C8"
                    }
                  },
                  {
                    "value": "move capacity off the weakest routes (+₹1.42 Cr a year), then a 5% fare rise on full, low-RASK routes (+₹0.74 Cr).",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0B1B2E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
