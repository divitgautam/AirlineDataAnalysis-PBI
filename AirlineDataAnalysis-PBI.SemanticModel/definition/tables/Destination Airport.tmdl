/// Arrival airport dimension (role-playing copy of reference/airports.csv).
table 'Destination Airport'
	lineageTag: a26c7ae6-16fd-471d-8d9d-de262bf831c9

	/// Three-letter airport code (key).
	column IATA
		dataType: string
		isKey
		lineageTag: 5c437246-106c-474f-a345-a6d7272af3bf
		summarizeBy: none
		sourceColumn: IATA

		annotation SummarizationSetBy = User

	/// Airport name.
	column Airport
		dataType: string
		lineageTag: 849afe89-153c-4640-bcc9-6b5bc9080c05
		summarizeBy: none
		sourceColumn: Airport

		annotation SummarizationSetBy = User

	/// City served.
	column City
		dataType: string
		lineageTag: d927623f-df9f-4440-81dc-5fa6e98588b6
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = User

	/// State or province.
	column State
		dataType: string
		lineageTag: d969a0c5-277d-4924-8ae5-743571260985
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = User

	/// Country.
	column Country
		dataType: string
		lineageTag: 79d4697c-9d11-42e3-9683-1ce11e4c34bd
		dataCategory: Country
		summarizeBy: none
		sourceColumn: Country

		annotation SummarizationSetBy = User

	/// Region of India, or International.
	column Region
		dataType: string
		lineageTag: 5d2c9300-01ff-41d4-bad4-43abdc99ebd5
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = User

	/// Code and city, e.g. PNQ · Pune.
	column 'Airport Label'
		dataType: string
		lineageTag: 413e1fa6-8544-44f0-a73a-164d5f0803ca
		summarizeBy: none
		sourceColumn: Airport Label

		annotation SummarizationSetBy = User

	partition 'Destination Airport' = m
		mode: import
		source =
				let
				    Source = AirportsRef,
				    Label = Table.AddColumn(Source, "Airport Label", each [IATA] & " · " & [City], type text),
				    Trimmed = Table.RemoveColumns(Label, {"Latitude", "Longitude"})
				in
				    Trimmed

	annotation PBI_ResultType = Table

