/// From analysis/output/pbi_levers.csv. Re-run the notebooks, then refresh.
table Levers
	lineageTag: 17124aa0-82e4-4f8e-85d1-d3ed24d212dc

	/// Revenue lever.
	column Lever
		dataType: string
		lineageTag: 26629440-d15d-43bd-af84-7f0abb8c1cb1
		summarizeBy: none
		sourceColumn: Lever

		annotation SummarizationSetBy = User

	/// Annual revenue uplift in rupees.
	column Uplift
		dataType: decimal
		formatString: #,##0
		lineageTag: b724a2ed-b93a-42fe-b48f-bbc0e0c0d1b7
		summarizeBy: none
		sourceColumn: Uplift

		annotation SummarizationSetBy = User

	/// How the lever was sized.
	column Basis
		dataType: string
		lineageTag: 9607894e-631d-4dce-a926-653f7ac10585
		summarizeBy: none
		sourceColumn: Basis

		annotation SummarizationSetBy = User

	/// Confidence in the sizing.
	column Confidence
		dataType: string
		lineageTag: 411ee934-efe2-4b6b-b053-b90a77422fbe
		summarizeBy: none
		sourceColumn: Confidence

		annotation SummarizationSetBy = User

	/// Lever name with its confidence, for charts.
	column 'Lever Label' = Levers[Lever] & " (" & LOWER ( Levers[Confidence] ) & ")"
		dataType: string
		lineageTag: 69dae7ad-fc67-45ff-a073-4d509ad48760
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Uplift as a share of annual revenue.
	column 'Uplift % of Revenue'
		dataType: decimal
		formatString: 0.0%
		lineageTag: f1ea01d6-3989-47b9-8843-f45598d0fc9e
		summarizeBy: none
		sourceColumn: Uplift % of Revenue

		annotation SummarizationSetBy = User

	partition Levers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_levers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Promoted,
				    Typed = Table.TransformColumnTypes(Blanks, {{"lever", type text}, {"uplift", Currency.Type}, {"basis", type text}, {"confidence", type text}, {"uplift_pct_of_revenue", Currency.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"lever", "Lever"}, {"uplift", "Uplift"}, {"basis", "Basis"}, {"confidence", "Confidence"}, {"uplift_pct_of_revenue", "Uplift % of Revenue"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs": ["ENSURE_TABLES_HAVE_RELATIONSHIPS"]}

