/// From analysis/output/pbi_levers.csv. Re-run the notebooks, then refresh.
table Levers
	lineageTag: abb3c641-a7f8-48be-bbe8-52267a4e316d

	column lever
		dataType: string
		lineageTag: a2200236-a14e-4e48-badf-54d7ebb5ed94
		summarizeBy: none
		sourceColumn: lever

		annotation SummarizationSetBy = User

	column uplift
		dataType: double
		formatString: #,##0
		lineageTag: f69a2726-c52a-485b-8fb4-96cdc92af2ef
		summarizeBy: none
		sourceColumn: uplift

		annotation SummarizationSetBy = User

	column basis
		dataType: string
		lineageTag: dd5d8bd8-1197-4b36-be13-393fcc8ac046
		summarizeBy: none
		sourceColumn: basis

		annotation SummarizationSetBy = User

	column confidence
		dataType: string
		lineageTag: c1d5e2f5-0919-4522-970f-f2a993a48358
		summarizeBy: none
		sourceColumn: confidence

		annotation SummarizationSetBy = User

	column uplift_pct_of_revenue
		dataType: double
		formatString: 0.0%
		lineageTag: 99667250-9e5c-45e3-a87d-449263694960
		summarizeBy: none
		sourceColumn: uplift_pct_of_revenue

		annotation SummarizationSetBy = User

	column 'Lever Label' = Levers[lever] & " (" & LOWER ( Levers[confidence] ) & ")"
		dataType: string
		lineageTag: 92342e09-ce10-40d1-8ed8-40ab4f5a8b38
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Levers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_levers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Promoted,
				    Typed = Table.TransformColumnTypes(Blanks, {{"lever", type text}, {"uplift", type number}, {"basis", type text}, {"confidence", type text}, {"uplift_pct_of_revenue", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

