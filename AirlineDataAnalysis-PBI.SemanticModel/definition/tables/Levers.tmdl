/// From analysis/output/pbi_levers.csv. Re-run the notebooks, then refresh.
table Levers
	lineageTag: 9c862649-1629-4e39-9c2a-d88d058c18ea

	column lever
		dataType: string
		lineageTag: 86bfef62-eb07-4346-9a7c-7919166c0ce8
		summarizeBy: none
		sourceColumn: lever

		annotation SummarizationSetBy = User

	column uplift
		dataType: double
		formatString: #,##0
		lineageTag: b4668940-64ef-4f2d-95aa-b2cf22a74ea1
		summarizeBy: none
		sourceColumn: uplift

		annotation SummarizationSetBy = User

	column basis
		dataType: string
		lineageTag: 29242743-7934-4ee8-a8a5-b00b2d195360
		summarizeBy: none
		sourceColumn: basis

		annotation SummarizationSetBy = User

	column confidence
		dataType: string
		lineageTag: f3fb8a62-b6f6-498d-b8b3-48c32d521f08
		summarizeBy: none
		sourceColumn: confidence

		annotation SummarizationSetBy = User

	column uplift_pct_of_revenue
		dataType: double
		formatString: 0.0%
		lineageTag: c1e5d891-2986-4dca-aef3-d569a3606f5b
		summarizeBy: none
		sourceColumn: uplift_pct_of_revenue

		annotation SummarizationSetBy = User

	partition Levers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_levers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Promoted,
				    Typed = Table.TransformColumnTypes(Blanks, {{"lever", type text}, {"uplift", type number}, {"basis", type text}, {"confidence", type text}, {"uplift_pct_of_revenue", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

