/// From analysis/output/pbi_forecast.csv. Re-run the notebooks, then refresh.
table Forecast
	lineageTag: 4eedf7e7-905c-430c-a7c7-881bab736c8a

	column Scenario
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 2333eba3-5536-4134-89f1-419a55eed194
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = User

	/// Month of the history or forecast value.
	column Month
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: f11cc71a-9584-4406-a326-dfe3b2b7bb09
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// Revenue or Passengers.
	column Metric
		dataType: string
		lineageTag: fb3570d9-4326-41e7-8316-1d9208a8ed93
		summarizeBy: none
		sourceColumn: Metric

		annotation SummarizationSetBy = User

	/// Actual or Forecast row.
	column Kind
		dataType: string
		lineageTag: a1b0180a-fb12-445d-a593-cda9a0a6871a
		summarizeBy: none
		sourceColumn: Kind

		annotation SummarizationSetBy = User

	/// Actual monthly value (history rows).
	column Actual
		dataType: decimal
		formatString: #,##0
		lineageTag: b9caff81-3b60-4424-8a10-14dcbb472886
		summarizeBy: none
		sourceColumn: Actual

		annotation SummarizationSetBy = User

	/// Forecast low case (10th percentile).
	column P10
		dataType: decimal
		formatString: #,##0
		lineageTag: fd5d5d72-6047-4897-8fed-6eb0eb3c934f
		summarizeBy: none
		sourceColumn: P10

		annotation SummarizationSetBy = User

	/// Forecast median.
	column P50
		dataType: decimal
		formatString: #,##0
		lineageTag: b457f49d-9828-4878-9fd4-b351682dada0
		summarizeBy: none
		sourceColumn: P50

		annotation SummarizationSetBy = User

	/// Forecast high case (90th percentile).
	column P90
		dataType: decimal
		formatString: #,##0
		lineageTag: 41bd4512-f9e1-41c0-998a-a34fd5e25b71
		summarizeBy: none
		sourceColumn: P90

		annotation SummarizationSetBy = User

	/// Month label for the forecast axis, e.g. Jun 25.
	column 'Month Label' = FORMAT ( Forecast[Month], "MMM yy" )
		dataType: string
		lineageTag: 7f510b5e-f90e-4200-8c20-90855e249d06
		summarizeBy: none
		sortByColumn: Month

		annotation SummarizationSetBy = Automatic

	partition Forecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_forecast.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"actual", "p10", "p50", "p90"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"scenario", type text}, {"month", type date}, {"metric", type text}, {"kind", type text}, {"actual", Currency.Type}, {"p10", Currency.Type}, {"p50", Currency.Type}, {"p90", Currency.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"scenario", "Scenario"}, {"month", "Month"}, {"metric", "Metric"}, {"kind", "Kind"}, {"actual", "Actual"}, {"p10", "P10"}, {"p50", "P50"}, {"p90", "P90"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

