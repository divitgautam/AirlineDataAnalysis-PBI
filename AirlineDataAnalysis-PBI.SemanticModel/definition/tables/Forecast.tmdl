/// From analysis/output/pbi_forecast.csv. Re-run the notebooks, then refresh.
table Forecast
	lineageTag: f927020b-44e7-464f-9012-92c0b08f9098

	column scenario
		dataType: string
		lineageTag: 8cb7902f-fad7-4811-a70c-21ca7d626dd1
		summarizeBy: none
		sourceColumn: scenario

		annotation SummarizationSetBy = User

	column month
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 6139727d-088c-48b1-8160-04a91fd626e7
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column metric
		dataType: string
		lineageTag: 548d0e49-b1bf-4ecb-a93a-5319eefe6dd9
		summarizeBy: none
		sourceColumn: metric

		annotation SummarizationSetBy = User

	column kind
		dataType: string
		lineageTag: e0191b6b-994f-466e-a6f9-0dd510058cf0
		summarizeBy: none
		sourceColumn: kind

		annotation SummarizationSetBy = User

	column actual
		dataType: double
		formatString: #,##0
		lineageTag: f80eed36-741a-4436-ac92-efe8f70877ef
		summarizeBy: none
		sourceColumn: actual

		annotation SummarizationSetBy = User

	column p10
		dataType: double
		formatString: #,##0
		lineageTag: 6e1f2939-83ba-4a89-962f-04c6b545bd07
		summarizeBy: none
		sourceColumn: p10

		annotation SummarizationSetBy = User

	column p50
		dataType: double
		formatString: #,##0
		lineageTag: 0ef8ef8f-0ea1-441e-be0c-8c70888fd838
		summarizeBy: none
		sourceColumn: p50

		annotation SummarizationSetBy = User

	column p90
		dataType: double
		formatString: #,##0
		lineageTag: f35b7d6b-983a-4a2e-915b-2bc06d757303
		summarizeBy: none
		sourceColumn: p90

		annotation SummarizationSetBy = User

	partition Forecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_forecast.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"actual", "p10", "p50", "p90"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"scenario", type text}, {"month", type date}, {"metric", type text}, {"kind", type text}, {"actual", type number}, {"p10", type number}, {"p50", type number}, {"p90", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

