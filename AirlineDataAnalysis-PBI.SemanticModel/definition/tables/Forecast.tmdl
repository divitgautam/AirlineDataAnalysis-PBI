/// From analysis/output/pbi_forecast.csv. Re-run the notebooks, then refresh.
table Forecast
	lineageTag: 3462576c-cef0-45ce-b4b0-e12eab0a6f69

	column scenario
		dataType: string
		lineageTag: cb5df72d-2d2b-40ea-be0a-d20fe3245303
		summarizeBy: none
		sourceColumn: scenario

		annotation SummarizationSetBy = User

	column month
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: d3bfc092-f599-4ae4-a005-226b07c4c7b6
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column metric
		dataType: string
		lineageTag: aae338bf-fd4b-4201-8b85-f119a7ba9fb2
		summarizeBy: none
		sourceColumn: metric

		annotation SummarizationSetBy = User

	column kind
		dataType: string
		lineageTag: a9fe5335-371b-48fd-b4a8-8478836e0672
		summarizeBy: none
		sourceColumn: kind

		annotation SummarizationSetBy = User

	column actual
		dataType: double
		formatString: #,##0
		lineageTag: f1223711-8ae5-488b-8ada-640c61ce6021
		summarizeBy: none
		sourceColumn: actual

		annotation SummarizationSetBy = User

	column p10
		dataType: double
		formatString: #,##0
		lineageTag: 12049224-cb97-44bb-a26a-b4531be64f98
		summarizeBy: none
		sourceColumn: p10

		annotation SummarizationSetBy = User

	column p50
		dataType: double
		formatString: #,##0
		lineageTag: 6b871861-587b-4468-a67a-0bf178e32b64
		summarizeBy: none
		sourceColumn: p50

		annotation SummarizationSetBy = User

	column p90
		dataType: double
		formatString: #,##0
		lineageTag: 1148d3da-8d07-4737-b6d0-b863644ecf0e
		summarizeBy: none
		sourceColumn: p90

		annotation SummarizationSetBy = User

	column 'Month Label' = FORMAT ( Forecast[month], "MMM yy" )
		dataType: string
		lineageTag: 8f6a5bff-f9b9-4915-a8cd-07603d5dbef2
		summarizeBy: none
		sortByColumn: month

		annotation SummarizationSetBy = Automatic

	partition Forecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_forecast.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"actual", "p10", "p50", "p90"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"scenario", type text}, {"month", type date}, {"metric", type text}, {"kind", type text}, {"actual", type number}, {"p10", type number}, {"p50", type number}, {"p90", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

