/// Shared scenario list so one slicer filters both forecast tables.
table Scenario
	lineageTag: 9ab5e9da-3890-4a4d-9d07-c4929b2e43a6

	/// Fare scenario (A: fares hold, B: fares settle).
	column Scenario
		dataType: string
		isKey
		lineageTag: 9284e9e2-d534-4b42-8290-ef6172e076e7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Scenario]

	partition Scenario = calculated
		mode: import
		source = DISTINCT ( SELECTCOLUMNS ( 'Forecast 2025', "Scenario", 'Forecast 2025'[Scenario] ) )

