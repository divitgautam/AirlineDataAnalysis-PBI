/// One row per flight (Raw Data CSV). Distance and fare-outlier rules: see analysis/src/metrics.py.
table Flights
	lineageTag: 38e7e265-da26-46e8-b9a9-144f482101cb

	/// Unique flight identifier from the source.
	column FlightID
		dataType: int64
		formatString: 0
		lineageTag: 077dcbe4-451a-44d5-9626-78b68135fa15
		summarizeBy: none
		sourceColumn: FlightID

		annotation SummarizationSetBy = User

	column Origin
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: b89aedd1-1f4b-4856-87e8-572c16788c88
		summarizeBy: none
		sourceColumn: Origin

		annotation SummarizationSetBy = User

	column Destination
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 5a7e5267-d838-40e8-9ffb-e47949bd27a3
		summarizeBy: none
		sourceColumn: Destination

		annotation SummarizationSetBy = User

	/// Commercial flight number.
	column FlightNumber
		dataType: int64
		formatString: 0
		lineageTag: c0ec0616-4b90-4a33-9f51-c4fb75c57b9f
		summarizeBy: none
		sourceColumn: FlightNumber

		annotation SummarizationSetBy = User

	/// Seats available on the flight.
	column Capacity
		dataType: int64
		formatString: #,##0
		lineageTag: 7bdf733e-b490-442d-ba90-0cadeea37440
		summarizeBy: none
		sourceColumn: Capacity

		annotation SummarizationSetBy = User

	/// Passengers carried.
	column PaxCount
		dataType: int64
		formatString: #,##0
		lineageTag: 15b40257-224b-41f5-b423-df5ada3fe306
		summarizeBy: none
		sourceColumn: PaxCount

		annotation SummarizationSetBy = User

	/// Revenue recorded for the flight (looks scaled; compare % changes).
	column Revenue
		dataType: int64
		formatString: #,##0
		lineageTag: 02cdabf8-6005-41dc-a5d5-4023fa057a07
		summarizeBy: none
		sourceColumn: Revenue

		annotation SummarizationSetBy = User

	column 'Departure Date'
		dataType: dateTime
		isHidden
		formatString: dd-mmm-yyyy
		isAvailableInMdx: false
		lineageTag: 89277105-33b5-4216-a3d5-f0452ca5391c
		summarizeBy: none
		sourceColumn: Departure Date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// TRUE when the recorded distance was replaced by the great-circle distance.
	column 'Distance Corrected'
		dataType: boolean
		lineageTag: 76b75223-10fd-4cdc-b552-f1f1a68284e4
		summarizeBy: none
		sourceColumn: Distance Corrected

		annotation SummarizationSetBy = User

	/// Flight distance used for ASK/RPK (recorded, or great-circle when corrected).
	column 'Distance Km'
		dataType: int64
		formatString: #,##0
		lineageTag: c102dd0a-a7d3-47ee-af65-f9d572e5e74c
		summarizeBy: none
		sourceColumn: Distance Km

		annotation SummarizationSetBy = User

	/// Origin-destination pair, e.g. PNQ-BLR.
	column Route
		dataType: string
		lineageTag: 777caf32-9639-40b3-add1-3e0f96069c9d
		summarizeBy: none
		sourceColumn: Route

		annotation SummarizationSetBy = User

	/// Domestic, or International when either airport is outside India.
	column Market
		dataType: string
		lineageTag: 672678df-ff0f-4cd4-aae0-50698556bb59
		summarizeBy: none
		sourceColumn: Market

		annotation SummarizationSetBy = User

	column ASK
		dataType: int64
		isHidden
		formatString: #,##0
		isAvailableInMdx: false
		lineageTag: 9325d96f-aac9-448e-a9f7-6030cf4ed499
		summarizeBy: none
		sourceColumn: ASK

		annotation SummarizationSetBy = User

	column RPK
		dataType: int64
		isHidden
		formatString: #,##0
		isAvailableInMdx: false
		lineageTag: 342aa449-9280-43c1-84bb-68edd1f2d1e9
		summarizeBy: none
		sourceColumn: RPK

		annotation SummarizationSetBy = User

	/// TRUE when fare per passenger is above 3x the route median.
	column 'Fare Outlier'
		dataType: boolean
		lineageTag: 021cf5ee-3c61-4079-aeb1-80ebe073539c
		summarizeBy: none
		sourceColumn: Fare Outlier

		annotation SummarizationSetBy = User

	partition Flights = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceFile), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"FlightID", Int64.Type}, {"DepartureDate", type text}, {"Origin", type text}, {"Destination", type text}, {"FlightNumber", Int64.Type}, {"Distance", Int64.Type}, {"DomesticFlag", Int64.Type}, {"Capacity", Int64.Type}, {"PaxCount", Int64.Type}, {"Revenue", Int64.Type}}, "en-US"),
				    Dated = Table.AddColumn(Typed, "Departure Date", each Date.FromText([DepartureDate], [Format = "dd-MM-yyyy", Culture = "en-GB"]), type date),
				    Airports = Table.Buffer(Table.SelectColumns(AirportsRef, {"IATA", "Latitude", "Longitude", "Country"})),
				    JoinO = Table.NestedJoin(Dated, {"Origin"}, Airports, {"IATA"}, "o", JoinKind.LeftOuter),
				    ExpO = Table.ExpandTableColumn(JoinO, "o", {"Latitude", "Longitude", "Country"}, {"o_lat", "o_lon", "o_country"}),
				    JoinD = Table.NestedJoin(ExpO, {"Destination"}, Airports, {"IATA"}, "d", JoinKind.LeftOuter),
				    ExpD = Table.ExpandTableColumn(JoinD, "d", {"Latitude", "Longitude", "Country"}, {"d_lat", "d_lon", "d_country"}),
				    GreatCircle = Table.AddColumn(ExpD, "Great Circle Km", each
				        let r = Number.PI / 180,
				            a = Number.Power(Number.Sin(([d_lat] - [o_lat]) * r / 2), 2)
				                + Number.Cos([o_lat] * r) * Number.Cos([d_lat] * r) * Number.Power(Number.Sin(([d_lon] - [o_lon]) * r / 2), 2)
				        in 6371 * 2 * Number.Asin(Number.Sqrt(a)), type number),
				    Corrected = Table.AddColumn(GreatCircle, "Distance Corrected", each
				        let ratio = [Distance] / [Great Circle Km] in not (ratio >= 0.9 and ratio <= 1.25), type logical),
				    DistKm = Table.AddColumn(Corrected, "Distance Km", each
				        if [Distance Corrected] then Number.Round([Great Circle Km], 0, RoundingMode.ToEven) else [Distance], Int64.Type),
				    Route = Table.AddColumn(DistKm, "Route", each [Origin] & "-" & [Destination], type text),
				    Market = Table.AddColumn(Route, "Market", each if [o_country] <> "India" or [d_country] <> "India" then "International" else "Domestic", type text),
				    ASK = Table.AddColumn(Market, "ASK", each [Capacity] * [Distance Km], Int64.Type),
				    RPK = Table.AddColumn(ASK, "RPK", each [PaxCount] * [Distance Km], Int64.Type),
				    Fare = Table.AddColumn(RPK, "Fare", each [Revenue] / [PaxCount], type number),
				    RouteMedians = Table.Group(Fare, {"Route"}, {{"Route Median Fare", each List.Median([Fare]), type number}}),
				    JoinMed = Table.NestedJoin(Fare, {"Route"}, RouteMedians, {"Route"}, "m", JoinKind.LeftOuter),
				    ExpMed = Table.ExpandTableColumn(JoinMed, "m", {"Route Median Fare"}),
				    Outlier = Table.AddColumn(ExpMed, "Fare Outlier", each [Fare] > 3 * [Route Median Fare], type logical),
				    Cleaned = Table.RemoveColumns(Outlier, {"DepartureDate", "o_lat", "o_lon", "o_country", "d_lat", "d_lon", "d_country", "Distance", "DomesticFlag", "Great Circle Km", "Fare", "Route Median Fare"})
				in
				    Cleaned

	annotation PBI_ResultType = Table

