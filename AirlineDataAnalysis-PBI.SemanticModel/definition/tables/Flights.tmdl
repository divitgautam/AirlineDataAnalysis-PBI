/// One row per flight (Raw Data CSV). Distance and fare-outlier rules: see analysis/src/metrics.py.
table Flights
	lineageTag: 17ac6782-ce4a-42ae-a3c2-45e042dbd997

	column FlightID
		dataType: int64
		formatString: 0
		lineageTag: 1b6ce285-548b-4156-bb97-2cf12cfd60d5
