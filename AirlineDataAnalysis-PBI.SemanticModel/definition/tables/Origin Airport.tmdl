/// Departure airport dimension (role-playing copy of reference/airports.csv).
table 'Origin Airport'
	lineageTag: 559b035c-89a3-40b0-b5e2-b5dbf4b32450

	/// Three-letter airport code (key).
	column IATA
		dataType: string
		isKey
		lineageTag: 300addbc-04a3-4eb7-9f5c-5af554cca110
		summarizeBy: none
		sourceColumn: IATA

		annotation SummarizationSetBy = User

	/// Airport name.
	column Airport
		dataType: string
		lineageTag: a6799915-7d48-4fb3-a9d6-64bee75105be
		summarizeBy: none
		sourceColumn: Airport

		annotation SummarizationSetBy = User

	/// City served.
	column City
		dataType: string
		lineageTag: 47956344-d1f5-4e08-b92c-e13609a819b4
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = User

	/// State or province.
	column State
		dataType: string
		lineageTag: 546d17f9-24ef-4848-8029-b547ae131e81
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = User

	/// Country.
	column Country
		dataType: string
		lineageTag: 060abd46-3da8-4c04-85c4-9989d27fcbb1
		dataCategory: Country
		summarizeBy: none
		sourceColumn: Country

		annotation SummarizationSetBy = User

	/// Region of India, or International.
	column Region
		dataType: string
		lineageTag: 5d0319d9-73c9-4d43-9ea7-fd296945f927
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = User

	/// Code and city, e.g. PNQ · Pune.
	column 'Airport Label'
		dataType: string
		lineageTag: 80dbc62b-903e-4c9b-9820-819a556921fb
		summarizeBy: none
		sourceColumn: Airport Label

		annotation SummarizationSetBy = User

	partition 'Origin Airport' = m
		mode: import
		source =
				let
				    Source = AirportsRef,
				    Label = Table.AddColumn(Source, "Airport Label", each [IATA] & " · " & [City], type text),
				    Trimmed = Table.RemoveColumns(Label, {"Latitude", "Longitude"})
				in
				    Trimmed

	annotation PBI_ResultType = Table

