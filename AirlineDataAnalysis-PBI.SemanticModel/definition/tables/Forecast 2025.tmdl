/// From analysis/output/pbi_forecast_2025.csv. Re-run the notebooks, then refresh.
table 'Forecast 2025'
	lineageTag: 06541f22-e076-4d35-92df-0d33a460d825

	column Scenario
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: f8abb766-30b2-4246-ab45-6c452f78e198
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = User

	/// Full-year or Jun-Dec total being forecast.
	column Metric
		dataType: string
		lineageTag: 1633708c-1869-4bb9-9004-26df64fa324c
		summarizeBy: none
		sourceColumn: Metric

		annotation SummarizationSetBy = User

	/// Low case (10th percentile).
	column P10
		dataType: decimal
		formatString: #,##0
		lineageTag: 198fbbdd-e0b5-4374-868c-9eedfd07b02a
		summarizeBy: none
		sourceColumn: P10

		annotation SummarizationSetBy = User

	/// Median.
	column P50
		dataType: decimal
		formatString: #,##0
		lineageTag: 2e290bd7-7610-4c98-bf7d-d0376ef94b3f
		summarizeBy: none
		sourceColumn: P50

		annotation SummarizationSetBy = User

	/// High case (90th percentile).
	column P90
		dataType: decimal
		formatString: #,##0
		lineageTag: e035c105-015a-4733-b1c1-74934151ef23
		summarizeBy: none
		sourceColumn: P90

		annotation SummarizationSetBy = User

	partition 'Forecast 2025' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_forecast_2025.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Promoted,
				    Typed = Table.TransformColumnTypes(Blanks, {{"scenario", type text}, {"metric", type text}, {"p10", Currency.Type}, {"p50", Currency.Type}, {"p90", Currency.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"scenario", "Scenario"}, {"metric", "Metric"}, {"p10", "P10"}, {"p50", "P50"}, {"p90", "P90"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

