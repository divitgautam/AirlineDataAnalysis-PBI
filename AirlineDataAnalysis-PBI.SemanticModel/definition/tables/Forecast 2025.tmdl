/// From analysis/output/pbi_forecast_2025.csv. Re-run the notebooks, then refresh.
table 'Forecast 2025'
	lineageTag: 8e1adf7e-d125-4857-b2a5-02988c444dc5

	column scenario
		dataType: string
		lineageTag: 890d59b0-8bad-44aa-82df-fe2773afbd58
		summarizeBy: none
		sourceColumn: scenario

		annotation SummarizationSetBy = User

	column metric
		dataType: string
		lineageTag: c766eaff-9435-49fd-92c1-ca96b93b4bad
		summarizeBy: none
		sourceColumn: metric

		annotation SummarizationSetBy = User

	column p10
		dataType: double
		formatString: #,##0
		lineageTag: 3aa70731-e691-4608-930d-fd290eab6ec7
		summarizeBy: none
		sourceColumn: p10

		annotation SummarizationSetBy = User

	column p50
		dataType: double
		formatString: #,##0
		lineageTag: 35b817f4-e982-4361-93c5-61a36ba0d613
		summarizeBy: none
		sourceColumn: p50

		annotation SummarizationSetBy = User

	column p90
		dataType: double
		formatString: #,##0
		lineageTag: 4820c011-da1c-4e98-a698-1b39b36b3ff1
		summarizeBy: none
		sourceColumn: p90

		annotation SummarizationSetBy = User

	partition 'Forecast 2025' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_forecast_2025.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Promoted,
				    Typed = Table.TransformColumnTypes(Blanks, {{"scenario", type text}, {"metric", type text}, {"p10", type number}, {"p50", type number}, {"p90", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

