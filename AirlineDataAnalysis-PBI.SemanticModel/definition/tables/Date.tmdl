/// Calendar from 1 Jan 2024 to the last flight date (31 May 2025); marked date table.
table Date
	lineageTag: 0a524b3f-7eba-4e19-b7a4-d256a5c3d29b
	dataCategory: Time

	/// Calendar date (key).
	column Date
		dataType: dateTime
		isKey
		formatString: dd-mmm-yyyy
		lineageTag: 180a4f9a-73d3-46e0-81bb-0347e2765276
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	/// Calendar year.
	column Year
		dataType: int64
		formatString: 0
		lineageTag: ffffacfb-247f-446a-9bc9-b4abe768aeca
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	/// Calendar quarter, Q1-Q4.
	column Quarter
		dataType: string
		lineageTag: 15e30a13-d872-4242-82b3-72678586c58e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	/// Month number, 1-12 (sorts Month).
	column 'Month No'
		dataType: int64
		formatString: 0
		lineageTag: ac1d12bb-33ab-44ec-ab56-0944e50e832c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month No]

	/// Month name, e.g. Jan.
	column Month
		dataType: string
		lineageTag: d53cdf5a-b32b-4093-93eb-06baef122bdd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month No'

	/// First day of the month.
	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 3fa92eec-0ca7-4617-8e3b-fcef474ee995
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

	/// Month label, e.g. Jan 24.
	column 'Year Month'
		dataType: string
		lineageTag: 1a94b017-8034-4822-89a6-b9199bc0b35e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]
		sortByColumn: 'Year Month Key'

	/// yyyymm number (sorts Year Month).
	column 'Year Month Key'
		dataType: int64
		formatString: 0
		lineageTag: 2a263114-393e-46cd-9e3d-186abca6d892
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Key]

	/// Weekday number, Monday = 1.
	column 'Weekday No'
		dataType: int64
		formatString: 0
		lineageTag: 9e669ce2-ff76-4025-93cd-9c5ddd094e72
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday No]

	/// Weekday name, e.g. Mon.
	column Weekday
		dataType: string
		lineageTag: e93465f4-ee81-4758-8aec-ad1509e6b24a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday]
		sortByColumn: 'Weekday No'

	partition Date = calculated
		mode: import
		source = ADDCOLUMNS ( CALENDAR ( DATE ( YEAR ( MIN ( Flights[Departure Date] ) ), 1, 1 ), MAX ( Flights[Departure Date] ) ), "Year", YEAR ( [Date] ), "Quarter", "Q" & QUARTER ( [Date] ), "Month No", MONTH ( [Date] ), "Month", FORMAT ( [Date], "MMM" ), "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ), "Year Month", FORMAT ( [Date], "MMM yy" ), "Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ), "Weekday No", WEEKDAY ( [Date], 2 ), "Weekday", FORMAT ( [Date], "ddd" ) )

