expression SourceFile = "D:\Wolf\PBI\AirlineDataAnalysis-PBI\Raw Data\Flight Data Assessment 2025.csv" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: f29d2eb9-b0c9-4cce-8b69-f1557c6f158f

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

/// Airport reference list (not loaded): feeds Flights and both airport tables.
expression AirportsRef =
		let
		    Source = Csv.Document(File.Contents(ProjectFolder & "\reference\airports.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(Promoted, {{"IATA", type text}, {"Airport", type text}, {"City", type text}, {"State", type text}, {"Country", type text}, {"Region", type text}, {"Latitude", type number}, {"Longitude", type number}}, "en-US")
		in
		    Typed
	lineageTag: f81ca7b8-3834-4ee5-8df1-485519423c5b

	annotation PBI_ResultType = Table

